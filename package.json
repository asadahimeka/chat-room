{
  "name": "chat-room",
  "version": "2.0.0",
  "description": "一个普通的聊天室（Bun 原生重写版）",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run dev:build & bun run dev:server",
    "test": "bun test",
    "build": "bun build ./src/views/room.client.ts --outdir ./static/js --format=esm --target=browser --minify",
    "dev:server": "bun --watch run src/index.ts",
    "dev:build": "bun build --watch ./src/views/room.client.ts --outdir ./static/js --format=esm --target=browser",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [],
  "author": "journey-ad",
  "license": "MIT",
  "dependencies": {
    "elysia": "^1.4.29",
    "fastscan": "^1.0.6",
    "sharp": "^0.35.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
