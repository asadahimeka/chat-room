{
  "name": "chat-room",
  "version": "2.0.0",
  "description": "一个普通的聊天室（Bun 原生重写版）",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "build": "bun build ./src/views/room.client.ts --outdir ./static/js --format=esm --target=browser",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [],
