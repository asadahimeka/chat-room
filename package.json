  "license": "MIT",
  "dependencies": {
    "elysia": "^1.0.0",
    "fastscan": "^1.0.6",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}